# ============================================================================
# LeadForge BACKEND environment — copy to .env and fill in.
#   cp .env.example .env
# DATABASE_URL and REDIS_URL are set by docker-compose.yml automatically.
# ============================================================================

# Host port the API is published on
BACKEND_PORT=4000

# ---- Database (Postgres container) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=leadforge

# ---- App ----
NODE_ENV=production

# Public frontend origin (for CORS + email links). Comma-separate multiple.
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# ---- Auth / JWT ----
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
NEXTAUTH_SECRET=change-me-nextauth-secret

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

# ---- Email ----
EMAIL_SERVICE=
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_SERVER_SECURE=
EMAIL_WORKSPACE_CREATE_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---- Data / AI providers ----
OPENAI_API_KEY=
SERPAPI_KEY=
APOLLO_API_KEY=
SIGNALHIRE_API_KEY=
SIGNALHIRE_CALLBACK_URL=https://api.yourdomain.com/api/webhooks/signalhire

# ---- Misc ----
LEAD_COUNT=
RATE_LIMIT_MAX=
TEST_MODE=

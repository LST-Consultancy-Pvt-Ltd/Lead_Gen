# ============================================================================
# LeadForge FRONTEND environment — copy to .env and fill in.
#   cp .env.example .env
# ============================================================================

# Host port the UI is published on
FRONTEND_PORT=3000

# PUBLIC backend API URL — baked into the browser bundle at build time.
# Must be reachable from the user's browser. Rebuild after changing.
#   e.g. https://api.yourdomain.com/api
#   or   https://yourdomain.com/api   (if you reverse-proxy /api -> backend)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

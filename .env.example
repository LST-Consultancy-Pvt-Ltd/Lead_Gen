# ============================================================================
# LeadForge AI — deployment environment (used by docker-compose.yml)
# Copy to `.env` and fill in real values:   cp .env.example .env
# ============================================================================

# ---- Ports exposed on the host (change if 3000/4000 are taken) --------------
FRONTEND_PORT=3000
BACKEND_PORT=4000

# ---- Database (Postgres container) -----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=leadforge
# NOTE: DATABASE_URL + REDIS_URL are set automatically in docker-compose.yml
# to point at the postgres/redis services. No need to set them here.

# ---- Public URLs -----------------------------------------------------------
# Where the browser reaches the backend API. On a server this must be your
# public domain (baked into the frontend at build time), e.g.
#   https://yourdomain.com/api        (if you reverse-proxy /api -> backend)
#   https://api.yourdomain.com/api    (if backend has its own subdomain)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Frontend origin, used by the backend for CORS + links in emails
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Auth / JWT ------------------------------------------------------------
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
NEXTAUTH_SECRET=change-me-nextauth-secret

# ---- Google OAuth ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- Email (SMTP + SendGrid) -----------------------------------------------
EMAIL_SERVICE=
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_SERVER_SECURE=
EMAIL_WORKSPACE_CREATE_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---- Third-party data / AI providers ---------------------------------------
OPENAI_API_KEY=
SERPAPI_KEY=
APOLLO_API_KEY=
SIGNALHIRE_API_KEY=
# Public URL SignalHire POSTs results back to (webhook), e.g.
#   https://yourdomain.com/api/webhooks/signalhire
SIGNALHIRE_CALLBACK_URL=

# ---- Misc ------------------------------------------------------------------
LEAD_COUNT=
RATE_LIMIT_MAX=
TEST_MODE=
